package {
    default_applicable_licenses: ["external_python_ptyprocess_license"],
}

license {
    name: "external_python_ptyprocess_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-ISC",
    ],
    license_text: [
        "LICENSE",
    ],
}

python_library_host {
    name: "ptyprocess",
    srcs: ["ptyprocess/*.py"],
}
